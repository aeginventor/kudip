# ── Supabase (개발 환경) ─────────────────────────────────────────────────────
SUPABASE_DB_URL=jdbc:postgresql://db.{YOUR_PROJECT_REF}.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# ── AWS RDS (운영 환경) ───────────────────────────────────────────────────────
RDS_DB_URL=jdbc:postgresql://{YOUR_RDS_ENDPOINT}:5432/kudip
RDS_DB_USERNAME=postgres
RDS_DB_PASSWORD=your-rds-db-password

# ── JWT ───────────────────────────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열 (생성: openssl rand -base64 32)
JWT_SECRET=your-256-bit-secret-key-here-minimum-32-characters

# ── AWS S3 (이미지 업로드) ────────────────────────────────────────────────────
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
